# Copy to .env for local overrides, or set these as Railway service variables.
# Railway supplies MONGO_PRIVATE_URL from the attached MongoDB service.

# Required locally. Railway production reads MONGO_PRIVATE_URL automatically.
MONGO_URL=mongodb://localhost:27017
# Optional local database name. Production defaults to goalpost.
MONGO_DB_NAME=goalpost
# Railway MongoDB users authenticate against admin unless configured otherwise.
MONGO_AUTH_SOURCE=admin

# Required once DEBUG=False (i.e. any real deployment):
SECRET_KEY=
DEBUG=False

# Shared password that gates the whole app (login screen). Also required
# once DEBUG=False. Signs into a JWT stored in an httponly cookie.
APP_PASSWORD=

# Comma-separated. Railway's own domain is trusted automatically via
# RAILWAY_PUBLIC_DOMAIN, so this is only for a custom domain.
ALLOWED_HOSTS=

# Gunicorn worker count.
WEB_CONCURRENCY=2
