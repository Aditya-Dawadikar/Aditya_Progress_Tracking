# Copy to .env for local overrides, or set these as Railway service variables.
# Local `manage.py runserver` works with none of these set.

# Required once DEBUG=False (i.e. any real deployment):
SECRET_KEY=
DEBUG=False

# Comma-separated. Railway's own domain is trusted automatically via
# RAILWAY_PUBLIC_DOMAIN, so this is only for a custom domain.
ALLOWED_HOSTS=

# SQLite file path. Point this at a mounted Railway volume (e.g. /data/db.sqlite3)
# so the database survives redeploys — Railway's container filesystem is ephemeral.
SQLITE_PATH=

# Gunicorn worker count.
WEB_CONCURRENCY=2
